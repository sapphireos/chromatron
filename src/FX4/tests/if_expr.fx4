number a;
number b;
number c;

fn test(number _a, number _b) number{

	return _a + _b;
}

if 1 + 2 == 3{
    a = 1;
}

if 1 + 2 != 3{
    a = 2;
}

if test(1, 2) == 3{
    b = 1;
}

if test(1, 2) != 3{
    b = 2;
}

if test(1, 2) + 3 == 3{
    c = 1;
}

if test(1, 2) + 3 != 3{
    c = 2;
}

assert a == 1;
assert b == 1;
assert c == 2;