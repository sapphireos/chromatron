fixed16 ary[4];

fixed16 a;
fixed16 b;
fixed16 c;
fixed16 d;
fixed16 e; 

ary[0] = 1.1;
ary[1] = 2.1;
ary[2] = 3.1;
ary[3] = 4.1;
ary[4] = 5.1;

ary += 123.123;

a = ary[0];
b = ary[1];
c = ary[2];
d = ary[3];
e = ary[4];

assert a == 128.22299;
assert b == 125.22299;
assert c == 126.22299;
assert d == 127.22299;
assert e == 128.22299;
