fn pix_hue_store(){
    pixels.hue = 0.0;

    pixels[0].hue = 0.5;
    pixels[1].hue = 1.0; // hue will shortcut to 65535, instead of wrapping 1.0 to 0.0.  Anything above 1.0 will wrap.
    pixels[2].hue = 1.5;

    assert pixels[0].hue == 0.5;
    assert pixels[1].hue == 1.0;
    assert pixels[2].hue == 0.5;
    assert pixels[3].hue == 0.0;
}
pix_hue_store();

fn pix_hue_store2(){
    pixels.hue = 1.0; // see note above about hue shortcut
    assert pixels[0].hue == 1.0;

    pixels.hue = 1.5;
    assert pixels[0].hue == 0.5;

    pixels.hue = -1.0;
    assert pixels[0].hue == 0.0;
}
pix_hue_store2();

fn pix_val_store(){
    pixels.val = 0.0;

    pixels[0].val = 0.5;
    pixels[1].val = 1.0;
    pixels[2].val = 1.5;

    assert pixels[0].val == 0.5;
    assert pixels[1].val == 1.0;
    assert pixels[2].val == 1.0;
    assert pixels[3].val == 0.0;
}
pix_val_store();

fn pix_val_store2(){
    pixels.val = 1.0;
    assert pixels[0].val == 1.0;

    pixels.val = 1.5;
    assert pixels[0].val == 1.0;

    pixels.val = -1.0;
    assert pixels[0].val == 0.0;
}
pix_val_store2();

fn pix_sat_store(){
    pixels.sat = 0.0;

    pixels[0].sat = 0.5;
    pixels[1].sat = 1.0;
    pixels[2].sat = 1.5;

    assert pixels[0].sat == 0.5;
    assert pixels[1].sat == 1.0;
    assert pixels[2].sat == 1.0;
    assert pixels[3].sat == 0.0;
}
pix_sat_store();

fn pix_sat_store2(){
    pixels.sat = 1.0;
    assert pixels[0].sat == 1.0;

    pixels.sat = 1.5;
    assert pixels[0].sat == 1.0;

    pixels.sat = -1.0;
    assert pixels[0].sat == 0.0;
}
pix_sat_store2();

fn pix_count(){
    assert pixels.count == 8;
}
pix_count();

fn pix_add_hue(){
    pixels.hue = 0.0;

    pixels.hue += 0.1;
    pixels[1].hue += 0.1;

    assert pixels[0].hue == 0.1;
    assert pixels[1].hue == 0.19999; // round off error, this is ok
}
pix_add_hue();

fn pix_hue_store_2d(){
    
    pixels[2, 1].hue = 0.1;

    assert pixels[2, 1].hue == 0.1;
}
pix_hue_store_2d();

fn pix_sat_store_2d(){
    
    pixels[2, 1].sat = 0.1;

    assert pixels[2, 1].sat == 0.1;
}
pix_sat_store_2d();

fn pix_val_store_2d(){
    
    pixels[2, 1].val = 0.1;

    assert pixels[2, 1].val == 0.1;
}
pix_val_store_2d();

fn pix_hsfade_store_2d(){
    
    pixels[2, 1].hsfade = 123;

    assert pixels[2, 1].hsfade == 123;
}
pix_hsfade_store_2d();

fn pix_vfade_store_2d(){
    
    pixels[2, 1].vfade = 123;

    assert pixels[2, 1].vfade == 123;
}
pix_vfade_store_2d();


