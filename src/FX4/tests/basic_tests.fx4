fn array_move(){
    ary = {99, 98, 97, 96};

    assert ary[0] == 99;
    assert ary[1] == 98;
    assert ary[2] == 97;
    assert ary[3] == 96;

}
array_move();

fn pixelarray_ref(){
    
    pixelarray &p;
    p = pixels;
    assert p.count == 8;

    pixels.count = 123;
    assert p.count == 123;
}
pixelarray_ref();

number ary_init[4] = 123;
fn array_declare_assign(){
    
    assert ary_init[0] == 123;
    assert ary_init[1] == 123;
    assert ary_init[2] == 123;
    assert ary_init[3] == 123;
}
array_declare_assign();

number ary_init2[4] = {99, 98, 97, 96};
fn array_declare_assign2(){
    
    assert ary_init2[0] == 99;
    assert ary_init2[1] == 98;
    assert ary_init2[2] == 97;
    assert ary_init2[3] == 96;
}
