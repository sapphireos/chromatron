
fn var_init(){
	number a;
	assert a == 0;
}
var_init();

fn arith(){
	assert 1 + 2 == 3;
	assert 3 - 2 == 1;
	assert 3 * 2 == 6;
	assert 8 / 4 == 2;
	assert 8 % 5 == 3;
}
arith();

fn arith2(){
	assert 1 + 2 - 3 * 10 / 5 == -3;
}
arith2();

fn simple_ifelse(){
    number a;
    number b;

    if a > 0{
        b = 1;
    }

    else{
        b = 2;
    }

    assert b == 2;
    assert a == 0;
}
simple_ifelse();


fn simple_ifelse2(){
    number a;
    number b;

    a = 1;

    if a > 0{
        b = 1;
    }

    else{
        b = 2;
    }

    assert b == 1;
    assert a == 1;
}
simple_ifelse2();


fn simple_if(){
    number a;
    number b;

    b = 2;

    if a > 0{
        b = 1;
    }

    assert b == 2;
    assert a == 0;
}
simple_if();

fn simple_if2(){
    number a;
    number b;

    b = 2;

    if a == 0{
        b = 1;
    }

    assert b == 1;
    assert a == 0;
}
simple_if2();

fn if_expr(){
    if 1 + 2 == 3{
        assert true;
    }

    else{
        assert false;
    }
}
if_expr();

fn multi_if_1(){
    number a;
    number b;

    a = 0;

    if a > 0{
        b = 1;
    }
    else if b == 0{
        a = 1;
    }

    else{
        b = 2;
    }

    assert b == 0;
    assert a == 1;
}
multi_if_1();

fn multi_if_2(){
    number a;
    number b;

    a = 1;

    if a > 0{
        b = 1;
    }
    else if b == 0{
        a = 1;
    }
    else{
        b = 2;
    }

    assert b == 1;
    assert a == 1;
}
multi_if_2();

fn multi_if_3(){
    number a;
    number b;

    a = -1;
    b = 1;

    if a > 0{
        b = 1;
    }
    else if b == 0{
        a = 1;
    }
    else{
        b = 2;
    }

    assert b == 2;
    assert a == -1;
}
multi_if_3();

fn nested_ifelse_0(){
    number a;
    number b;
    number c;

    a = 0;
    b = 0;

    if a <= 0{
        if b == 0{
            c = 1;
        }
        else{
            c = 2;
        }
    }
    else{
        if b == 0{
            c = 3;
        }
        else{
            c = 4;
        }
    }

    assert c == 1;
}
nested_ifelse_0();

fn nested_ifelse_1(){
    number a;
    number b;
    number c;

    a = 0;
    b = 1;

    if a <= 0{
        if b == 0{
            c = 1;
        }
        else{
            c = 2;
        }
    }
    else{
        if b == 0{
            c = 3;
        }
        else{
            c = 4;
        }
    }

    assert c == 2;
}
nested_ifelse_1();

fn nested_ifelse_2(){
    number a;
    number b;
    number c;

    a = 1;
    b = 0;

    if a <= 0{
        if b == 0{
            c = 1;
        }
        else{
            c = 2;
        }
    }
    else{
        if b == 0{
            c = 3;
        }
        else{
            c = 4;
        }
    }

    assert c == 3;
}
nested_ifelse_2();

fn nested_ifelse_3(){
    number a;
    number b;
    number c;

    a = 1;
    b = 1;

    if a <= 0{
        if b == 0{
            c = 1;
        }
        else{
            c = 2;
        }
    }
    else{
        if b == 0{
            c = 3;
        }
        else{
            c = 4;
        }
    }
    assert c == 4;
}
nested_ifelse_3();

fn for_loop(){
    number a;

    for i in 4{
        a += 1;
    }

    assert a == 4;
}
for_loop();

fn double_for_loop(){
    number a;

    for i in 4{
        for j in 3{
            a += 1;
        }
    }

    assert a == 12;
}

fn for_loop_break(){
    number a;

    for i in 4{
        if i == 2{
            break;
        }

        a += 1;
    }

    assert a == 2;
}
for_loop_break();

fn for_loop_continue(){
    number a;

    for i in 4{
        if i >= 2{
            continue;
        }

        a += 1;
    }

    assert a == 2;
}
for_loop_continue();

fn while_loop(){
    number a;

    while a < 4{
        a += 1;
    }

    assert a == 4;
}
while_loop();

fn while_loop2(){
    number i;
    i = 4;

    number a;
    a = 1;

    while i > 0{
        i -= 1;

        a += 1;
    }

    assert a == 5;
    assert i == 0;
}
while_loop2();

fn double_while_loop(){
    number i;
    i = 4;

    number a;

    while i > 0{
        i -= 1;
        number j;

        j = 5;

        while j > 0{
            j -= 1;

            a += 1;
        }
    }

    assert a == 20;
}
double_while_loop();

fn while_loop_break(){
    number a;

    while a < 4{
        if a == 2{
            break;
        }

        a += 1;
    }

    assert a == 2;
}
while_loop_break();

fn while_loop_continue(){
    number a;
    number b;

    while a < 4{
        a += 1;

        if a >= 2{
            continue;
        }

        b += 1;
    }

    assert a == 4;
    assert b == 1;
}
while_loop_continue();

number global_a;
fn global_var(){
  global_a += 1;

  assert global_a == 1;
}
global_var();

number global_b;
fn global_readonly(){
  assert global_b == 0;
}
global_readonly();

number ary[4];

fn array_lookup(){
    number b;
    ary = 0;
    ary[b] = 1;
    b = 1;
    ary[b] = 2;

    assert ary[0] == 1;
    assert ary[1] == 2;
    assert ary[2] == 0;
    assert ary[3] == 0;
}
array_lookup();

fn array_lookup_op(){
    number b;
    ary = 3;
    ary[b] = 1;
    b = 1;
    ary[b] += 2;

    assert ary[0] == 1;
    assert ary[1] == 5;
    assert ary[2] == 3;
    assert ary[3] == 3;
}
array_lookup_op();

fn array_lookup_op2(){
    number b;
    ary = 3;
    ary[b] = 1;
    b = 1;
    ary[b] = ary[b] + 2;

    assert ary[0] == 1;
    assert ary[1] == 5;
    assert ary[2] == 3;
    assert ary[3] == 3;
}
array_lookup_op2();

fn array_store(){
    ary = 0;
    ary[0] = 1;
    ary[1] = ary[0];

    assert ary[0] == 1;
    assert ary[1] == 1;
    assert ary[2] == 0;
    assert ary[3] == 0;
}
array_store();

fn array_store2(){
    ary = 0;
    number b;

    ary[b] = 1;
    ary[b + 1] = ary[0];

    assert ary[0] == 1;
    assert ary[1] == 1;
    assert ary[2] == 0;
    assert ary[3] == 0;
}
array_store2();

fn array_assign(){
    ary = 0;
    ary = 1;
    assert ary[0] == 1;
    assert ary[1] == 1;
    assert ary[2] == 1;
    assert ary[3] == 1;
}
array_assign();

fn array_vector(){
    ary = 1;
    ary += 1;
    assert ary[0] == 2;
    assert ary[1] == 2;
    assert ary[2] == 2;
    assert ary[3] == 2;
}
array_vector();

number ary2[2, 3];

fn array2_lookup(){
    number b;
    ary2[b, 0] = 1;
    ary2[b, 1] = 2;
    ary2[b, 2] = 3;
    b = 1;
    ary2[b] = 2;
    ary2[b, 0] = 4;
    ary2[b, 1] = 5;
    ary2[b, 2] = 6;

    assert ary2[0, 0] == 1;
    assert ary2[0, 1] == 2;
    assert ary2[0, 2] == 3;
    assert ary2[1, 0] == 4;
    assert ary2[1, 1] == 5;
    assert ary2[1, 2] == 6;
}
array2_lookup();

fn array2_vector(){
    ary2 = 3;

    assert ary2[0, 0] == 3;
    assert ary2[0, 1] == 3;
    assert ary2[0, 2] == 3;
    assert ary2[1, 0] == 3;
    assert ary2[1, 1] == 3;
    assert ary2[1, 2] == 3;

    ary2 += 1;

    assert ary2[0, 0] == 4;
    assert ary2[0, 1] == 4;
    assert ary2[0, 2] == 4;
    assert ary2[1, 0] == 4;
    assert ary2[1, 1] == 4;
    assert ary2[1, 2] == 4;

    ary2[0] = 5;

    assert ary2[0, 0] == 5;
    assert ary2[0, 1] == 4;
    assert ary2[0, 2] == 4;
    assert ary2[1, 0] == 4;
    assert ary2[1, 1] == 4;
    assert ary2[1, 2] == 4;

    ary2[0] += 1;

    assert ary2[0, 0] == 6;
    assert ary2[0, 1] == 4;
    assert ary2[0, 2] == 4;
    assert ary2[1, 0] == 4;
    assert ary2[1, 1] == 4;
    assert ary2[1, 2] == 4;
}
array2_vector();

fn func_param(number a){
    a += 1;
    
    assert a == 2;
}
func_param(1);

fn sub(number a, number b) number{
    return a - b;
}
    
fn add(number a, number b) number{
    return a + b;
}
     
fn func_call(){
    assert sub(1, 2) == -1;
    assert add(1, 2) == 3;
} 
func_call();

fn type_conversions(){
    number a;
    fixed16 b;
    fixed16 c;
    number d;
    
    a = 123.456;
    b = 32;

    c = 123;
    c += 123;

    d = 123.123;
    d += 123.123;

    assert a == 123;
    assert b == 32;
    assert c == 246.0;
    assert d == 246;
}
type_conversions();


fixed16 ary_f16[4];

fn type_conversions_array(){
    number a;
    fixed16 b;
    fixed16 c;
    number d;

    ary_f16 = 3.123;

    a = ary_f16[1];
    b = ary_f16[1];

    ary = 3.123;
    c = ary[1];

    ary += 3.123;
    d = ary[1];

    assert a == 3;
    assert b == 3.123;
    assert c == 3.0;
    assert d == 6;
}
type_conversions_array();

fn type_conversions_binop(){
    number a;
    fixed16 b;

    a = 123;
    b = a * 0.333;

    assert a == 123;
    assert b == 40.95809;
}
type_conversions_binop();

