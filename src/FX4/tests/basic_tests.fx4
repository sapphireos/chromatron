// 2 pixels starting at index 3 (4th pixel in array)
pixelarray p1;
p1.index = 3;
p1.count = 2;

fn obj_store_direct(){
    pixels.hue = 0.0;

    assert p1[0].hue == 0.0;
    assert p1[1].hue == 0.0;
    assert p1[2].hue == 0.0;
    
    p1.hue = 0.5;

    assert p1[0].hue == 0.5;
    assert p1[1].hue == 0.5;
    assert p1[2].hue == 0.5;
}
obj_store_direct();

